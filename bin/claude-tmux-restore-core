#!/usr/bin/env bash
# One-shot restore of every saved tmux session. Never attaches.
#
# Shared by `claude-session` (attach-or-restore, interactive) and
# `claude-tmux-boot-restore` (headless, systemd at login).
#
# Usage: claude-tmux-restore-core [session]
#   With a session name, that session is guaranteed to exist afterwards
#   (created empty if the saved layout has no such session).
#
# Idempotent: if any session from the saved layout is already running this is a
# no-op, so it never clobbers sessions built by hand. Restore stays deliberately
# one-shot and manual (@continuum-restore is off) because the
# restore-on-session-created hook races and re-restores bad layouts.
#
# Two things this handles that a naive `new-session -d -s claude; restore.sh`
# does not:
#
#  1. It bootstraps with a THROWAWAY session name, never a saved session's.
#
#     tmux-resurrect only overwrites an already-existing pane when the whole
#     server has exactly one pane -- detect_if_restoring_from_scratch()
#     (restore.sh:245) counts `tmux list-panes -a` server-wide. So if any other
#     tmux session happens to be running, a pre-created `claude:1.1` is instead
#     registered as "already exists" and its process is deliberately NOT
#     restored (restore.sh:192). You silently lose the first pane's claude.
#     Letting resurrect create every session from the state file avoids that.
#
#     It also removes the need for a "drop the leftover bootstrap window" step.
#     The old code ran `kill-window -t claude:1` after restoring, but resurrect
#     had already REUSED that window for real restored content -- so the kill
#     destroyed the first saved window, and `renumber-windows on` shifted every
#     other window down one index, making the loss easy to miss. That is what
#     ate a 3-pane window on 2026-07-29.
#
#  2. It waits for the restore to actually settle instead of a fixed `sleep`,
#     then reports a short restore instead of failing silently.
set -uo pipefail

SESSION="${1:-}"
RESURRECT_DIR="${CLAUDE_TMUX_RESURRECT_DIR:-$HOME/.local/share/tmux/resurrect}"
LAST="$RESURRECT_DIR/last"
RESTORE_SH="$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
TIMEOUT="${CLAUDE_TMUX_RESTORE_TIMEOUT:-60}"
BOOTSTRAP="__claude_restore_bootstrap_$$"

log() { printf 'claude-tmux-restore: %s\n' "$*" >&2; }

# Start a session with the server in a scope of its own. The first new-session
# forks the tmux server, and a process stays in the cgroup of whatever started
# it: run from claude-tmux-restore.service, the server lived inside that unit,
# so stopping or restarting the unit killed tmux and every pane with it. Falls
# back to a plain new-session when there is no user manager to ask, so a restore
# never fails over this. Only the call that starts the server needs the scope.
new_session() {
  tmux info >/dev/null 2>&1 && { tmux new-session -d "$@"; return; }
  systemd-run --user --scope --quiet --collect --unit="tmux-server-$$" \
    --description="tmux server (claude-tmux-restore)" \
    -- tmux new-session -d "$@" 2>/dev/null \
    || tmux new-session -d "$@"
}

command -v tmux >/dev/null 2>&1 || exit 0

# Provider guard: if the global default is GLM but its vault key is unfetchable
# (vault re-seals on every reboot), revert the default to Anthropic so the
# panes about to be restored launch on a working provider instead of dying on
# a failing apiKeyHelper. No-op unless GLM is both active AND broken.
"$HOME/.local/bin/claude-provider" guard >/dev/null 2>&1 || true

# Make sure the requested session exists (a no-op without one).
ensure_session() {
  [ -n "$SESSION" ] || return 0
  tmux has-session -t "=$SESSION" 2>/dev/null || new_session -s "$SESSION"
}

if [ ! -f "$LAST" ] || [ ! -x "$RESTORE_SH" ]; then
  log "no saved layout (or resurrect missing); nothing to restore"
  ensure_session
  exit 0
fi

# Every session the saved state holds, and how many panes/windows each should
# end up with.
mapfile -t saved < <(awk -F'\t' '$1=="pane" { print $2 }' "$LAST" | sort -u)

if [ "${#saved[@]}" -eq 0 ]; then
  log "saved layout has no panes; nothing to restore"
  ensure_session
  exit 0
fi

# Already up -- never touch it. Any saved session running means this server
# was restored (or rebuilt by hand) already.
for s in "${saved[@]}"; do
  if tmux has-session -t "=$s" 2>/dev/null; then
    ensure_session
    exit 0
  fi
done

want_panes="$(awk -F'\t' '$1=="pane"' "$LAST" | wc -l)"

# Bootstrap under a throwaway name so resurrect builds every saved session itself.
new_session -s "$BOOTSTRAP"
# shellcheck disable=SC2064
trap "tmux kill-session -t '=$BOOTSTRAP' 2>/dev/null" EXIT

tmux run-shell "$RESTORE_SH"

# Panes server-wide, minus the bootstrap's.
restored_panes() {
  tmux list-panes -a -F '#{session_name}' 2>/dev/null | grep -cvxF -- "$BOOTSTRAP"
}

# Poll until the pane count reaches the target, or stops moving for ~3s.
deadline=$((SECONDS + TIMEOUT))
prev=-1
stalled=0
while [ "$SECONDS" -lt "$deadline" ]; do
  now="$(restored_panes)"
  [ "$now" -ge "$want_panes" ] && break
  if [ "$now" -eq "$prev" ]; then
    stalled=$((stalled + 1))
    [ "$stalled" -ge 6 ] && break
  else
    stalled=0
    prev="$now"
  fi
  sleep 0.5
done

# The bootstrap must stay up until the requested session exists, or killing
# the last session would take the server down with it.
ensure_session
tmux kill-session -t "=$BOOTSTRAP" 2>/dev/null
trap - EXIT

short=0
for s in "${saved[@]}"; do
  want_p="$(awk -F'\t' -v s="$s" '$1=="pane"   && $2==s' "$LAST" | wc -l)"
  want_w="$(awk -F'\t' -v s="$s" '$1=="window" && $2==s' "$LAST" | wc -l)"
  if ! tmux has-session -t "=$s" 2>/dev/null; then
    log "RESTORE FAILED: resurrect created no '$s' session"
    short=1
    continue
  fi
  got_p="$(tmux list-panes -s -t "=$s" -F x 2>/dev/null | wc -l)"
  got_w="$(tmux list-windows  -t "=$s" -F x 2>/dev/null | wc -l)"
  if [ "$got_p" -lt "$want_p" ] || [ "$got_w" -lt "$want_w" ]; then
    log "INCOMPLETE RESTORE of '$s': got ${got_w}w/${got_p}p, expected ${want_w}w/${want_p}p"
    short=1
  else
    log "restored '$s': ${got_w} windows / ${got_p} panes"
  fi
done

if [ "$short" -eq 1 ]; then
  log "saved layout: $(readlink -f "$LAST" 2>/dev/null || echo "$LAST")"
  log "continuum overwrites 'last' on its next autosave -- copy that file aside now if you need it"
fi
