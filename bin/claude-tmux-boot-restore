#!/usr/bin/env bash
# Headless one-shot restore of the 'claude' tmux session at login.
# Mirrors `claude-session` but never attaches (runs from systemd, no terminal).
#
# All the actual logic -- and the reasons behind it -- live in
# claude-tmux-restore-core; this is just the systemd entry point.
set -uo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin${PATH:+:$PATH}"

exec "$(dirname "$(readlink -f "$0")")/claude-tmux-restore-core"
