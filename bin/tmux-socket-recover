#!/usr/bin/env bash
# Give a running tmux server its socket back without wrecking its umask.
#
# SIGUSR1 makes a tmux server recreate its socket, which is the only way back
# in once the socket file is gone. On tmux 3.5a (Debian trixie; trixie-backports
# has 3.6b, same bug) that path has a trap: server_create_socket() sets umask
# 0117 around bind() and, when bind() fails, returns without restoring it
# (server.c:125-135). The server then keeps 0117 for the rest of its life, and
# every pane opened afterwards creates directories with no execute bit. Fixed
# upstream in 6238793ad7, first released in 3.8.
#
# bind() fails exactly when the socket DIRECTORY is missing, which is the usual
# reason to reach for SIGUSR1. On 2026-10-20 a /tmp sweep deleted /tmp/tmux-1000,
# a bare `kill -USR1` into the missing directory hit the leak, and a day later
# new Claude sessions could not write their transcripts.
#
# So this recreates the directory first, signals only when the socket is
# actually gone, and then checks the server's umask. It never kills or restarts
# a server: with the socket present and answering it only reads.
#
# Usage: tmux-socket-recover [socket-path]   (default /tmp/tmux-$UID/default)
#        tmux-socket-recover --check         exit 1 if any tmux server of this
#                                            user has the wrong umask
# Expected umask: $TMUX_EXPECTED_UMASK (default 0002, systemd --user's).
set -uo pipefail

EXPECTED="${TMUX_EXPECTED_UMASK:-0002}"

server_umask() { awk '/^Umask:/ {print $2}' "/proc/$1/status" 2>/dev/null; }

# Listening tmux server pid for a socket path. ss still reports the bound path
# after the file is unlinked, so this works when the socket is gone.
server_pid() {
  ss -xlpH 2>/dev/null | awk -v p="$1" '$5 == p' \
    | grep -o 'tmux: server",pid=[0-9]*' | head -1 | grep -o '[0-9]*$'
}

# Returns 1 and says how to fix it when pid's umask is not the expected one.
check_umask() {
  local pid=$1 cur
  cur=$(server_umask "$pid")
  if [ -z "$cur" ]; then
    echo "tmux server $pid: cannot read /proc/$pid/status" >&2
    return 1
  fi
  if [ "$((8#$cur))" -ne "$((8#$EXPECTED))" ]; then
    echo "tmux server $pid has umask $cur, expected $EXPECTED; every new pane inherits it." >&2
    echo "  fix in place (no restart): sudo gdb -p $pid -batch -nx -ex 'call (unsigned int)umask($((8#$EXPECTED)))' -ex detach" >&2
    return 1
  fi
  echo "tmux server $pid: umask $cur ok"
}

if [ "${1:-}" = --check ]; then
  rc=0
  for pid in $(pgrep -u "$(id -u)" -x 'tmux: server'); do
    check_umask "$pid" || rc=1
  done
  if [ "$rc" -ne 0 ] && command -v notify-send >/dev/null; then
    notify-send -u critical "tmux umask is wrong" "Run: tmux-socket-recover --check" 2>/dev/null
  fi
  exit "$rc"
fi

sock="${1:-/tmp/tmux-$(id -u)/default}"
pid=$(server_pid "$sock")
if [ -z "$pid" ]; then
  echo "no tmux server is listening on $sock" >&2
  exit 1
fi

if [ -S "$sock" ] && tmux -S "$sock" list-sessions >/dev/null 2>&1; then
  echo "$sock is present and answering; not signalling."
  check_umask "$pid"
  exit
fi

dir=$(dirname "$sock")
# tmux refuses a socket directory that group or others can reach.
if [ ! -d "$dir" ]; then
  mkdir -m 700 "$dir" || exit 1
  echo "recreated $dir"
fi

kill -USR1 "$pid" || exit 1
for _ in $(seq 50); do
  [ -S "$sock" ] && break
  sleep 0.1
done
if [ ! -S "$sock" ]; then
  echo "tmux server $pid did not recreate $sock" >&2
  check_umask "$pid"
  exit 1
fi
echo "tmux server $pid is listening on $sock again"
check_umask "$pid"
