#!/usr/bin/env bash
# tmux-resurrect  @resurrect-hook-post-save-layout  hook.
#
# Rewrites each claude pane's restore command (field 11 of the resurrect state
# file) from the bare `claude --resume` (interactive picker) to
# `claude --resume <sessionId>`, so a restored pane reattaches to the *exact*
# Claude session it was running — even when several sessions share one repo.
#
# The session id is resolved from Claude's live running-session registries
# (~/.claude/sessions/ and ~/.claude-accounts/*/sessions/<pid>.json), reached by walking each pane's process
# subtree to the registered (version-execed) claude pid. Registry files can
# vanish while their sessions keep running (seen 2026-10-12: every file but
# one was gone, and saves silently lost all ids), so two fallbacks follow:
# the session's open scratch dir handle (/tmp/claude-<uid>/<project>/<id>/…),
# then a `--resume <id>` on the process command line.
#
# Runs BEFORE resurrect's dedup (save.sh:246), so a stable layout still dedups
# to a single state file — no churn.
#
# $1 = path to the just-written resurrect state file.
set -uo pipefail

state="${1:-}"
[ -n "$state" ] && [ -f "$state" ] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

# pid -> sessionId, from the live session registry.
#
# EVERY account's registry, not just ~/.claude's. Since the account split
# (2026-10-18) each session registers under its own CLAUDE_CONFIG_DIR,
# ~/.claude-accounts/<name>/sessions/, and ~/.claude/sessions stays empty — so
# this loop found nothing and every id came from the fallbacks below (measured
# 2026-10-20: 36 panes, 29 by scratch fd, 7 by argv, 0 by registry).
#
# An entry counts only while its pid is alive AND started when the entry says
# (procStart = field 22 of /proc/<pid>/stat). A registry file can outlive its
# process, and a reused pid belonging to another claude would otherwise pin
# that pane to the wrong conversation.
declare -A REG
_starttime() { local s; s="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1; s="${s##*) }"; set -- $s; printf '%s' "${20}"; }
shopt -s nullglob
for f in "$HOME"/.claude/sessions/*.json "$HOME"/.claude-accounts/*/sessions/*.json; do
  pid="$(basename "$f" .json)"
  sid="$(grep -o '"sessionId":"[^"]*"' "$f" 2>/dev/null | head -1 | cut -d'"' -f4)"
  started="$(grep -o '"procStart":"[^"]*"' "$f" 2>/dev/null | head -1 | cut -d'"' -f4)"
  [ -n "$sid" ] && [ -n "$started" ] && [ "$(_starttime "$pid")" = "$started" ] && REG["$pid"]="$sid"
done
shopt -u nullglob

UUID='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
_sid_of() {
  local p=$1 sid="${REG[$1]:-}"
  [ -n "$sid" ] || sid="$(ls -l "/proc/$p/fd" 2>/dev/null | grep -oE "/tmp/claude-$(id -u)/[^/]+/$UUID" | head -1 | awk -F/ '{print $NF}')"
  [ -n "$sid" ] || sid="$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -oE -- "--resume $UUID" | head -1 | cut -d' ' -f2)"
  printf '%s' "$sid"
}

# session:win.pane -> sessionId, by walking each claude pane's subtree
_descendants() { local p=$1 c; printf '%s\n' "$p"; for c in $(pgrep -P "$p" 2>/dev/null || true); do _descendants "$c"; done; }

# Claude keys each transcript directory off the pane's cwd, with '/', '.' and
# '_' all folded to '-'  (/home/me/repos/a_b/.x -> -home-me-repos-a-b--x).
_project_key() { printf '%s' "$1" | sed 's/[\/._]/-/g'; }

mapfile="$(mktemp)"
trap 'rm -f "$mapfile"' EXIT
while IFS='|' read -r pos ppid cmd cwd; do
  [ "$cmd" = "claude" ] || continue
  for d in $(_descendants "$ppid"); do
    sid="$(_sid_of "$d")"
    [ -n "$sid" ] || continue
    # Only pin --resume if that transcript is actually resumable FROM THIS CWD.
    # Renaming a repo moves the cwd, and with it the project key, orphaning
    # every transcript filed under the old path; `claude --resume <id>` then
    # dies with "No conversation found" on every future restore. Degrade to a
    # plain `claude` so the pane still comes up in the right directory.
    # emit  session <tab> win <tab> pane <tab> restore-command
    if [ -f "$HOME/.claude/projects/$(_project_key "$cwd")/$sid.jsonl" ]; then
      printf '%s\tclaude --resume %s\n' "${pos//[:.]/	}" "$sid" >> "$mapfile"
    else
      printf '%s\tclaude\n' "${pos//[:.]/	}" >> "$mapfile"
    fi
    break
  done
done < <(tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}|#{pane_pid}|#{pane_current_command}|#{pane_current_path}' 2>/dev/null || true)

[ -s "$mapfile" ] || exit 0

# Rewrite field 11 for the claude panes we resolved.
tmp="$(mktemp)"
awk -F'\t' -v OFS='\t' '
  NR==FNR { cmd[$1 SUBSEP $2 SUBSEP $3] = $4; next }
  /^pane/ && $10 == "claude" {
    k = $2 SUBSEP $3 SUBSEP $6
    if (k in cmd) $11 = ":" cmd[k]
  }
  { print }
' "$mapfile" "$state" > "$tmp" && cat "$tmp" > "$state"
rm -f "$tmp"
